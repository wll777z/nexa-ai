# ── NEXA AI — variáveis de ambiente do servidor ──────────────────────────────
# Copie este arquivo para ".env" e ajuste os valores. NUNCA versione o ".env".

# Porta do servidor HTTP
PORT=4000

# Ambiente: development | production
NODE_ENV=development

# Caminho do arquivo do banco SQLite (relativo à pasta server/)
DATABASE_PATH=./data/nexa.db

# Segredo usado para assinar os tokens de acesso (JWT).
# Em produção use uma string aleatória longa (mínimo 32 caracteres).
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Validade do token de acesso
JWT_EXPIRES_IN=12h

# Origem permitida no CORS (endereço do frontend em desenvolvimento)
CORS_ORIGIN=http://localhost:5173

# ── Geração de sites com IA (opcional) ─────────────────────────────────────
# Sem estas variáveis, o criador de sites funciona em modo "estrutura em branco"
# e a interface explica como conectar. A chave NUNCA vai para o frontend.
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=sua-chave-aqui
# AI_MODEL=gpt-4o-mini

# ── Construtor de sites por chat (Claude) ──────────────────────────────────
# Necessária para a tela "Construtor por chat" (HTML completo em streaming).
# Crie a chave em https://console.anthropic.com
# ANTHROPIC_API_KEY=sua-chave-aqui
# Opcional: troque o modelo (padrão: claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5
